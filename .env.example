# Copy these into Hostinger: Websites > your Web App > Environment variables

# MySQL database (hPanel > Databases > MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_baraka
DB_PASSWORD=your-database-password
DB_NAME=u123456789_baraka

# Email for sign-in codes (hPanel > Emails). Hostinger SMTP: smtp.hostinger.com, port 465
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=system@barakasolar.com
SMTP_PASS=your-email-password
MAIL_FROM=Baraka Import System <system@barakasolar.com>

# First administrator (created only when there are no users yet)
ADMIN_EMAIL=you@barakasolar.com
ADMIN_PASSWORD=ChangeThisPassword123
ADMIN_NAME=Administrator

NODE_ENV=production
